{
  "name": "behavior-tree-ts",
  "version": "0.0.0",
  "description": "A (mostly) copy & paste repo of [BehaviorTree.CPP]",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./build/dist/index.cjs",
  "module": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js",
      "require": "./build/dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.dev.json && rollup -c",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "lint": "eslint"
  },
  "keywords": [
    "BehaviorTree"
  ],
  "license": "MIT",
  "dependencies": {
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "rollup": "^4.64.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
